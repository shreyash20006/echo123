# Echo.TGPCOP Environment Variables
# Fill in your Supabase & Cloudinary values below.
# (Do NOT commit your production keys to a public git repo)

# 1. Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon Public Key (anon key only - NEVER use service_role)
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 3. Cloudinary White Transparent Logo Link
CLOUDINARY_LOGO_URL=https://res.cloudinary.com/your-cloud/image/upload/logo.png
